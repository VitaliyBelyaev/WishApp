
CREATE TABLE Tag (
 tagId TEXT PRIMARY KEY NOT NULL,
 title TEXT NOT NULL,
 color TEXT NOT NULL DEFAULT 'butter'
);

insert:
INSERT INTO Tag(tagId, title, color)
VALUES (?,?,?);

updateColor:
UPDATE Tag
SET color = ?
    WHERE  tagId = ?;

countByColor:
SELECT color, count(*) AS tagsCount
FROM Tag
GROUP BY color;

updateTitle:
UPDATE Tag
SET title = ?
    WHERE  tagId = ?;

getAll:
SELECT *
FROM Tag
ORDER BY title ASC;

getById:
SELECT *
FROM Tag
WHERE tagId = ?;

deleteByIds:
DELETE FROM Tag
WHERE tagId IN ?;

clear:
DELETE FROM Tag;

insertOrReplace:
INSERT OR REPLACE INTO Tag(tagId, title, color)
VALUES (?,?,?);

getAllForBackup:
SELECT *
FROM Tag;