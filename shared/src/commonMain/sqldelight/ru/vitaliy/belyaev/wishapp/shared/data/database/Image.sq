
CREATE TABLE Image (
 id TEXT PRIMARY KEY NOT NULL,
 wishId TEXT NOT NULL,
 rawData BLOB NOT NULL
);

insert:
INSERT INTO Image(id, wishId, rawData)
VALUES (?,?,?);

getAllRefs:
SELECT id, wishId
FROM Image
ORDER BY rowid;

getRefsByWishId:
SELECT id, wishId
FROM Image
WHERE wishId = ?
ORDER BY rowid;

getRawDataById:
SELECT rawData
FROM Image
WHERE id = ?;

deleteByIds:
DELETE FROM Image
WHERE id IN ?;

deleteByWishIds:
DELETE FROM Image
WHERE wishId IN ?;

deleteById:
DELETE FROM Image
WHERE id = ?;

clear:
DELETE FROM Image;

insertOrReplace:
INSERT OR REPLACE INTO Image(id, wishId, rawData)
VALUES (?,?,?);

getAllForBackup:
SELECT *
FROM Image;

